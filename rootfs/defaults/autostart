#!/bin/sh
# openbox runs this with /bin/sh (dash) whatever the shebang says, and dash
# silently skips bashisms such as [[ ]] and arrays.
#
# The launch below must not be an `exec`. The base image's svc-watchdog, enabled
# by RESTART_APP in the Dockerfile, restarts the app by watching for
#
#     pgrep -o -u abc -f "sh $HOME/.config/openbox/autostart"
#
# and `exec` replaces this process, so that pattern stops matching and a closed
# PrusaSlicer stays closed on an empty desktop. LinuxServer's own Selkies images
# do not `exec` here either.

# Under PUID=0 the session runs as root, whose HOME differs from abc's, so the
# XDG dirs are pinned to /config for every PUID.
export XDG_CONFIG_HOME="/config/.config"
export XDG_DATA_HOME="/config/.local/share"
export XDG_CACHE_HOME="/config/.cache"

# This styles the GTK dialogs; PrusaSlicer's own dark mode is a separate
# setting under Preferences, General.
export GTK_THEME="${GTK_THEME:-Adwaita-dark}"

echo "[prusaslicer-autostart] launching PrusaSlicer (XDG_CONFIG_HOME=$XDG_CONFIG_HOME, GTK_THEME=$GTK_THEME)" >&2

# A session bus quiets the dbus warnings and lets file-chooser portals work.
dbus-launch --exit-with-session /usr/bin/prusa-slicer
